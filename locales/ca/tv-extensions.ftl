# Textos de tv-extensions en català. Les claus són les de
# locales/en/tv-extensions.ftl; `~` marca la tecla ràpida (Alt+lletra).

## Autocompleció

tvx-autocomplete-required = Cal un valor
tvx-autocomplete-not-in-list = Trieu un valor de la llista
tvx-autocomplete-no-matches = Cap coincidència

## Llista doble

tvx-dual-filter = Filtre:
tvx-dual-available = Disponibles
tvx-dual-chosen = Triats
tvx-dual-header = { $title } ({ $total })
tvx-dual-header-filtered = { $title } ({ $shown } de { $total })
tvx-dual-min-one = Trieu almenys un element
tvx-dual-min-many = Trieu almenys { $count } elements
tvx-dual-max-one = Trieu com a màxim un element
tvx-dual-max-many = Trieu com a màxim { $count } elements

## Camps de formulari

tvx-form-problem = { $name } { $problem }
tvx-form-required = { $name } és obligatori
tvx-form-must-be-checked = { $name } ha d'estar marcat
tvx-form-this-field = Aquest camp
tvx-form-must-be-whole-number = ha de ser un nombre enter
tvx-form-must-be-number = ha de ser un nombre
tvx-form-must-be-date = ha de ser una data com 2026-12-31
tvx-form-must-be-time = ha de ser una hora com 14:30
tvx-form-not-valid = no és vàlid
tvx-form-must-be-chosen = s'ha de triar

## Diàlegs carregats des de JSON

tvx-dialog-more-errors = { $message } (i { $count } més)

## Finestra de registre

tvx-log-title = Registre

